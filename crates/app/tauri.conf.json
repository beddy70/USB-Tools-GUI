{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turbo Everdrive USB Tools",
  "version": "0.1.0",
  "identifier": "com.turbofx.everdrivetools",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Turbo Everdrive USB Tools",
        "width": 1180,
        "height": 800,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
